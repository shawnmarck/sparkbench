# SparkBench host identity — copy to one of:
#   /etc/spark/host.env          (preferred; install/spark-install bootstrap)
#   /opt/spark/host.env          (no sudo; gitignored)
# Install scripts and nginx read these via install/common.sh.
# Secrets (SMB passwords) belong in /etc/spark/smb-credentials-models — never here.

SPARK_HOST=sparky
SPARK_LAN_IP=192.168.0.101
SPARK_USER=techno

# Optional NAS shelf (install/spark-install nas)
# NAS_IP=192.168.0.99

# Optional TensorFold kit when a recipe omits tensorfold.launcher.
# The kit is host-local (Mia start.sh). It is not cloned by spark engine tensorfold.
# SPARK_TENSORFOLD_LAUNCHER=/path/to/Qwen3.8-Flash-Next-Single-DGX-Spark-TensorFold
