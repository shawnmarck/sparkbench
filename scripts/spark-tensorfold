#!/usr/bin/env bash
# MiaAI Qwen3.8-Flash-Next on TensorFold Zig — one DGX Spark.
# The kit (start.sh) is host-local and is not in git. Engine id: tensorfold.
set -euo pipefail

ROOT="${SPARK_ROOT:-/opt/spark}"
for _host_env in /etc/spark/host.env "${ROOT}/host.env"; do
  if [[ -f "${_host_env}" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "${_host_env}"
    set +a
    break
  fi
done
unset _host_env
LAUNCHER="${SPARK_TENSORFOLD_LAUNCHER:-/models/azampatti/qwen3.8-flash-next-int4-autoround/kit}"
HF_HOME_DEFAULT="/models/azampatti/qwen3.8-flash-next-int4-autoround/hf"
RUN_DIR="${ROOT}/run"
LOG_DIR="${ROOT}/logs"
LOG_FILE="${LOG_DIR}/tensorfold.log"
PID_FILE="${RUN_DIR}/tensorfold.pid"
PORT="${TENSORFOLD_PORT:-8000}"
CONTAINER_NAME="${TENSORFOLD_CONTAINER:-qwen38-flash-next-tf}"

die() { echo "ERROR: $*" >&2; exit 1; }

require_kit() {
  if [[ -x "${LAUNCHER}/start.sh" && -x "${LAUNCHER}/stop.sh" ]]; then
    return 0
  fi
  die "TensorFold kit not installed at ${LAUNCHER}. Set tensorfold.launcher in the recipe or SPARK_TENSORFOLD_LAUNCHER in host.env. The kit is host-local and is not cloned automatically."
}

load_recipe() {
  local recipe="${SPARK_TENSORFOLD_RECIPE:-}"
  CTX="${TENSORFOLD_CTX:-262144}"
  SERVED_NAME="${TENSORFOLD_SERVED_NAME:-Qwen3.8-Flash-Next}"
  HF_HOME_DIR="${TENSORFOLD_HF_HOME:-${HF_HOME_DEFAULT}}"
  KV_DTYPE="${TENSORFOLD_KV_DTYPE:-fp8}"
  PARALLEL="${TENSORFOLD_PARALLEL:-8}"
  VISION="${TENSORFOLD_VISION:-1}"
  DRAFTS="${TENSORFOLD_DRAFTS:-1}"
  THINKING="${TENSORFOLD_THINKING:-1}"
  CHECKPOINT="${TENSORFOLD_CHECKPOINT:-}"
  MODEL_ID="${TENSORFOLD_MODEL_ID:-}"
  MODEL_REVISION="${TENSORFOLD_MODEL_REVISION:-}"
  PREPARE="${TENSORFOLD_PREPARE:-}"
  [[ -n "${recipe}" && -f "${recipe}" ]] || return 0
  eval "$(
    python3 - "${recipe}" <<'PY'
import shlex, sys, yaml
recipe = yaml.safe_load(open(sys.argv[1])) or {}
tf = recipe.get("tensorfold") or {}
ctx = (recipe.get("context") or {}).get("default") or 262144
kv = (recipe.get("context") or {}).get("kv_default") or "fp8"

def emit(key, value):
    print(f"{key}={shlex.quote(str(value))}")

print(f"PORT={int(recipe.get('port') or 8000)}")
print(f"CTX={int(ctx)}")
emit("SERVED_NAME", recipe.get("served_name") or "Qwen3.8-Flash-Next")
emit("HF_HOME_DIR", tf.get("hf_home") or "/models/azampatti/qwen3.8-flash-next-int4-autoround/hf")
emit("KV_DTYPE", kv)
print(f"PARALLEL={int(tf.get('parallel') or 8)}")
print(f"VISION={1 if tf.get('vision', True) else 0}")
print(f"DRAFTS={1 if tf.get('drafts', True) else 0}")
print(f"THINKING={1 if tf.get('thinking', True) else 0}")
if tf.get("checkpoint"):
    emit("CHECKPOINT", tf["checkpoint"])
if tf.get("model_id"):
    emit("MODEL_ID", tf["model_id"])
if tf.get("model_revision"):
    emit("MODEL_REVISION", tf["model_revision"])
if tf.get("prepare") is not None:
    emit("PREPARE", tf["prepare"])
if tf.get("launcher"):
    emit("LAUNCHER", tf["launcher"])
if tf.get("container"):
    emit("CONTAINER_NAME", tf["container"])
PY
  )"
}

load_launch_overrides() {
  local ov="${ROOT}/run/inference-launch-overrides.json"
  [[ -f "${ov}" ]] || return 0
  eval "$(
    python3 - "${ov}" <<'PY'
import json, shlex, sys
d = json.load(open(sys.argv[1]))
if d.get("ctx"):
    print(f"CTX={int(d['ctx'])}")
if d.get("kv"):
    print(f"KV_DTYPE={shlex.quote(str(d['kv']))}")
PY
  )"
}

tensorfold_running() {
  docker inspect -f '{{.State.Running}}' "${CONTAINER_NAME}" 2>/dev/null | grep -qx true
}

stop_others() {
  "${ROOT}/scripts/spark-eugr" down 2>/dev/null || true
  "${ROOT}/scripts/spark-llama" down 2>/dev/null || true
  "${ROOT}/scripts/spark-ds4" down 2>/dev/null || true
  "${ROOT}/scripts/spark-sparkinfer" down 2>/dev/null || true
  "${ROOT}/scripts/spark-sglang" down 2>/dev/null || true
  "${ROOT}/scripts/spark-flash-next" down 2>/dev/null || true
}

cmd_down() {
  if [[ -x "${LAUNCHER}/stop.sh" ]]; then
    (cd "${LAUNCHER}" && CONTAINER_NAME="${CONTAINER_NAME}" ./stop.sh) || true
  fi
  docker rm -f "${CONTAINER_NAME}" >/dev/null 2>&1 || true
  rm -f "${PID_FILE}"
  echo "Stopped TensorFold"
}

cmd_up() {
  load_recipe
  load_launch_overrides
  require_kit
  mkdir -p "${RUN_DIR}" "${LOG_DIR}" "${HF_HOME_DIR}"
  stop_others
  cmd_down >/dev/null || true

  export HF_HOME="${HF_HOME_DIR}"
  export HF_CACHE="${HF_HOME_DIR}"
  export PORT
  export HOST="${TENSORFOLD_HOST:-0.0.0.0}"
  export SERVED_NAME
  export CONTEXT="${CTX}"
  export KV_DTYPE
  export PARALLEL
  export VISION
  export DRAFTS
  export THINKING
  export CONTAINER_NAME
  export CHECKPOINT
  export MODEL_ID
  export MODEL_REVISION
  export PREPARE
  # Keep Hugging Face auth for first-boot snapshot if weights are missing.
  if [[ -z "${HF_TOKEN:-}" && -f "${HOME}/.cache/huggingface/token" ]]; then
    HF_TOKEN="$(cat "${HOME}/.cache/huggingface/token")"
    export HF_TOKEN
  fi

  : >"${LOG_FILE}"
  (
    cd "${LAUNCHER}"
    ./start.sh
  ) >>"${LOG_FILE}" 2>&1
  echo "started $(date -u +%FT%TZ) port=${PORT} ctx=${CTX} kv=${KV_DTYPE} vision=${VISION}" >>"${LOG_FILE}"
  python3 - "${SPARK_TENSORFOLD_RECIPE:-}" "${RUN_DIR}/inference-active.json" <<'PY' || true
import json, sys
from pathlib import Path
recipe_path, state_path = sys.argv[1], Path(sys.argv[2])
profile = None
if recipe_path:
    try:
        import yaml
        profile = (yaml.safe_load(open(recipe_path)) or {}).get("id")
    except Exception:
        profile = None
state = {}
if state_path.is_file():
    try:
        state = json.loads(state_path.read_text()) or {}
    except Exception:
        state = {}
if profile:
    state["profile"] = profile
elif not state.get("profile"):
    sys.exit(0)
state_path.parent.mkdir(parents=True, exist_ok=True)
state_path.write_text(json.dumps(state, indent=2) + "\n")
PY
  if tensorfold_running; then
    docker inspect -f '{{.Id}}' "${CONTAINER_NAME}" >"${PID_FILE}" 2>/dev/null || true
  fi
  echo "Started TensorFold — ${SERVED_NAME} on :${PORT} ctx=${CTX} kv=${KV_DTYPE} vision=${VISION}"
  echo "Log: ${LOG_FILE}"
  echo "API: http://sparky:${PORT}/v1"
  echo "First boot pulls the Zig image and the recipe checkpoint; /v1/models can take 10+ min."
}

cmd_status() {
  if tensorfold_running; then
    echo "Running ${CONTAINER_NAME} — http://127.0.0.1:${PORT}/v1/models"
    curl -sf --max-time 5 "http://127.0.0.1:${PORT}/v1/models" | head -c 800 || echo "(API not ready yet)"
    echo
  else
    echo "Not running"
  fi
}

cmd_logs() {
  if tensorfold_running; then
    docker logs -f "${CONTAINER_NAME}"
  else
    tail -f "${LOG_FILE}"
  fi
}

usage() {
  cat <<USAGE
Usage: spark engine tensorfold {up|down|status|logs}

MiaAI Qwen3.8-Flash-Next TensorFold Zig (:${PORT}/v1)
Launcher: ${LAUNCHER}
USAGE
}

cmd="${1:-}"
[[ -n "${cmd}" ]] || { usage; exit 1; }
load_recipe
case "${cmd}" in
  up) cmd_up ;;
  down) cmd_down ;;
  status) cmd_status ;;
  logs) cmd_logs ;;
  *) usage >&2; exit 1 ;;
esac
